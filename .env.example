# ============================================================
#  Health+ — Plantilla de Variables de Entorno
#  Copia este archivo a `.env` y completa los valores reales.
#  ESTE ARCHIVO SÍ puede subirse a git (no contiene secretos).
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=healthplus_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA

# --- Kafka KRaft Cluster ---
# Genera uno con: docker run --rm confluentinc/cp-kafka:7.6.1 kafka-storage random-uuid
CLUSTER_ID=CAMBIA_ESTE_CLUSTER_ID

# --- Servicios internos (valores por defecto para Docker Compose) ---
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
CITAS_SERVICE_URI=http://citas-service:8081
